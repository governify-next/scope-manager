# Service configuration
NODE_ENV=development
GOV_LOG_LEVEL=INFO
GOV_SERVICE_NAME=scope-manager
PORT=5901

# Database URIs
MONGO_URI=mongodb://localhost:27017/governify

# JWT configuration
SERVICE_AUTHENTICATION_ENABLED=false
JWT_SECRET=governify_secret_key

# OpenID Connect configuration
OIDC_ENABLED=false
OIDC_ISSUER_URL=https://issuer.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://example.com/api/v1/users/oidc/callback
OIDC_SCOPE=openid email profile

# Application-specific settings
MAX_ROLES_PER_ORGANIZATION = 100;
MAX_MEMBERS_PER_ORGANIZATION = 1000;
